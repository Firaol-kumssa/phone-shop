# Phone Shop Management System — environment template
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phone_shop?schema=public"

# HTTP server
PORT=3000

# Auth (Blueprint Part 11 — JWT with inactivity expiry)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"
